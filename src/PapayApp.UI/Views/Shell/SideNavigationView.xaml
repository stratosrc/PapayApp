<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.Shell.SideNavigationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Padding="10,20"
        BackgroundColor="{DynamicResource NavigationBackground}"
        WidthRequest="68">
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="10"
            VerticalOptions="Start">
            <Button x:Name="HomeNavBorder" ImageSource="home.png" Padding="8" TextColor="White" Command="{Binding ShowHomeCommand}" SemanticProperties.Description="Inicio" ToolTipProperties.Text="Inicio" BackgroundColor="{Binding HomeButtonBackground}" BorderColor="{DynamicResource OutlineColor}" BorderWidth="1" HeightRequest="48" WidthRequest="48" />

            <Button x:Name="DocumentsNavBorder" ImageSource="document.png" Padding="8" TextColor="White" Command="{Binding ShowDocumentsCommand}" SemanticProperties.Description="Evaluaciones" ToolTipProperties.Text="Evaluaciones" BackgroundColor="{Binding DocumentsButtonBackground}" BorderColor="{DynamicResource OutlineColor}" BorderWidth="1" HeightRequest="48" WidthRequest="48" />

            <Button x:Name="CertificatesNavBorder" ImageSource="diploma.png" Padding="8" TextColor="White" Command="{Binding ShowCertificatesCommand}" SemanticProperties.Description="Certificados" ToolTipProperties.Text="Certificados" BackgroundColor="{Binding CertificatesButtonBackground}" BorderColor="{DynamicResource OutlineColor}" BorderWidth="1" HeightRequest="48" WidthRequest="48" />

            <Button x:Name="FoldersNavBorder" ImageSource="folder.png" Padding="8" TextColor="White" Command="{Binding ShowFoldersCommand}" SemanticProperties.Description="Archivos" ToolTipProperties.Text="Archivos" BackgroundColor="{Binding FoldersButtonBackground}" BorderColor="{DynamicResource OutlineColor}" BorderWidth="1" HeightRequest="48" WidthRequest="48" />

            <Button x:Name="SettingsNavBorder" ImageSource="settings.png" Padding="8" TextColor="White" Command="{Binding ShowSettingsCommand}" SemanticProperties.Description="Ajustes" ToolTipProperties.Text="Ajustes" BackgroundColor="{Binding SettingsButtonBackground}" BorderColor="{DynamicResource OutlineColor}" BorderWidth="1" HeightRequest="48" WidthRequest="48" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
