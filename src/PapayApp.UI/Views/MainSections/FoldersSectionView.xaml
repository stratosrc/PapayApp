<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.FoldersSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ScrollView>
        <VerticalStackLayout
            Padding="36"
            Spacing="18">
            <Label
                FontFamily="Segoe UI Semibold"
                FontSize="28"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="{Binding FoldersTitle}"
                TextColor="{StaticResource PrimaryText}" />

            <Border
                BackgroundColor="{StaticResource SurfaceBackground}"
                Padding="18"
                Stroke="{StaticResource OutlineColor}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="14"
                        Text="{Binding FoldersCurrentPathText}"
                        TextColor="{StaticResource PrimaryText}" />

                    <HorizontalStackLayout Spacing="10">
                        <Button
                            BackgroundColor="{StaticResource InputBackground}"
                            Command="{Binding NavigateUpDirectoryCommand}"
                            IsEnabled="{Binding CanNavigateUpDirectory}"
                            Text="Atras"
                            TextColor="{StaticResource PrimaryText}" />
                        <Button
                            BackgroundColor="{StaticResource InputBackground}"
                            Command="{Binding RefreshDirectoriesCommand}"
                            Text="Actualizar"
                            TextColor="{StaticResource PrimaryText}" />
                        <Button
                            BackgroundColor="{StaticResource PrimaryButtonBackground}"
                            Command="{Binding OpenCurrentDirectoryCommand}"
                            Text="Abrir carpeta actual"
                            TextColor="White" />
                    </HorizontalStackLayout>

                    <Label
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Text="{Binding FoldersStatusMessage}"
                        TextColor="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding DirectoryEntries}"
                IsVisible="{Binding HasDirectoryEntries}"
                Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="{StaticResource SurfaceBackground}"
                            Padding="16"
                            Stroke="{StaticResource OutlineColor}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand}"
                                    NumberOfTapsRequired="2" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="14">
                                <Image
                                    HeightRequest="22"
                                    Source="{Binding IconSource}"
                                    VerticalOptions="Center"
                                    WidthRequest="22" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">
                                    <Label
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="15"
                                        Text="{Binding Name}"
                                        TextColor="{StaticResource PrimaryText}" />
                                    <Label
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Text="{Binding RelativePath}"
                                        TextColor="{StaticResource SecondaryText}" />
                                    <Label
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Text="{Binding ModifiedText}"
                                        TextColor="{StaticResource SecondaryText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
