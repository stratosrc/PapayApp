<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.CertificatesSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PapayApp.UI.Controls">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="CertificateFieldLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
                <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
            </Style>

            <Style x:Key="CertificateInputBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource InputBackground}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 7" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>

            <Style x:Key="CertificateEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource PlaceholderText}" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
            </Style>

            <Style x:Key="CertificateEditor" TargetType="Editor">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
                <Setter Property="HeightRequest" Value="100" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource PlaceholderText}" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
            </Style>

            <Style x:Key="CertificateDatePicker" TargetType="DatePicker">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid
        Padding="30,36,30,24"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label
                FontFamily="Segoe UI Semibold"
                FontSize="28"
                HorizontalTextAlignment="Center"
                Text="{Binding Title}"
                TextColor="{DynamicResource PrimaryText}" />
            <Label Text="{Binding ActiveTemplateName}" HorizontalTextAlignment="Center" TextColor="{DynamicResource SecondaryText}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        BackgroundColor="{Binding ExcelModeBackground}"
                        Command="{Binding SelectExcelModeCommand}"
                        Text="Generación desde Excel"
                        TextColor="{Binding ExcelModeTextColor}" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="{Binding ManualModeBackground}"
                        Command="{Binding SelectManualModeCommand}"
                        Text="Generación manual"
                        TextColor="{Binding ManualModeTextColor}" />
                </Grid>

                <VerticalStackLayout Spacing="14">
                    <Border
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        Padding="16"
                        Stroke="{DynamicResource OutlineColor}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="16"
                                Text="Participantes"
                                TextColor="{DynamicResource PrimaryText}" />

                            <VerticalStackLayout
                                IsVisible="{Binding IsExcelMode}"
                                Spacing="8">
                                <Button Style="{DynamicResource SecondaryAction}"
                                    Command="{Binding PickExcelCommand}"
                                    Text="Seleccionar Excel" />
                                <Label
                                    FontFamily="Segoe UI"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding ExcelFileName}"
                                    TextColor="{DynamicResource SecondaryText}" />
                                <Label
                                    FontFamily="Segoe UI"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Text="{Binding ExcelRulesText}"
                                    TextColor="{DynamicResource SecondaryText}" />
                                <Label
                                    FontFamily="Segoe UI"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Text="{Binding ImportStatus}"
                                    TextColor="{DynamicResource SecondaryText}" />

                                <Grid
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="6"
                                    IsVisible="{Binding HasParticipants}">
                                    <Label
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="{DynamicResource SmallFontSize}"
                                        Text="{Binding ParticipantsCountText}"
                                        TextColor="{DynamicResource PrimaryText}"
                                        VerticalOptions="Center" />
                                    <Button Style="{DynamicResource SecondaryAction}"
                                        Grid.Column="1"
                                        Command="{Binding SelectAllCommand}"
                                        FontSize="{DynamicResource SmallFontSize}"
                                        Padding="10,5"
                                        Text="Todos" />
                                    <Button Style="{DynamicResource SecondaryAction}"
                                        Grid.Column="2"
                                        Command="{Binding ClearSelectionCommand}"
                                        FontSize="{DynamicResource SmallFontSize}"
                                        Padding="10,5"
                                        Text="Ninguno" />
                                </Grid>

                                <CollectionView
                                    HeightRequest="220"
                                    IsVisible="{Binding HasParticipants}"
                                    ItemsSource="{Binding Participants}"
                                    SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,5"
                                                Padding="8,6"
                                                Stroke="{DynamicResource OutlineColor}"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <CheckBox
                                                        IsChecked="{Binding IsSelected}"
                                                        VerticalOptions="Center" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                        <Label
                                                            FontFamily="Segoe UI Semibold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding FullName}"
                                                            TextColor="{DynamicResource PrimaryText}" />
                                                        <Label
                                                            FontFamily="Segoe UI"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="{Binding Summary}"
                                                            TextColor="{DynamicResource SecondaryText}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                IsVisible="{Binding IsManualMode}"
                                Spacing="8">
                                <Label
                                    Style="{DynamicResource CertificateFieldLabel}"
                                    Text="Nombre y apellidos" />
                                <Border Style="{DynamicResource CertificateInputBorder}">
                                    <Entry
                                        Placeholder="Ej.: María Pérez González"
                                        Style="{DynamicResource CertificateEntry}"
                                        Text="{Binding ManualFullName}" />
                                </Border>
                                <Label
                                    Style="{DynamicResource CertificateFieldLabel}"
                                    Text="Cédula de identificación" />
                                <Border Style="{DynamicResource CertificateInputBorder}">
                                    <Entry
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        Placeholder="10 dígitos"
                                        Style="{DynamicResource CertificateEntry}"
                                        Text="{Binding ManualIdentification}" />
                                </Border>
                                <Label
                                    FontFamily="Segoe UI"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Text="Estos datos generarán un solo certificado."
                                    TextColor="{DynamicResource SecondaryText}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        Padding="16"
                        Stroke="{DynamicResource OutlineColor}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="16"
                                Text="Contenido del certificado"
                                TextColor="{DynamicResource PrimaryText}" />
                            <Label
                                Style="{DynamicResource CertificateFieldLabel}"
                                Text="Tipo de certificado" />
                            <Border Style="{DynamicResource CertificateInputBorder}">
                                <Entry
                                    Placeholder="Ej.: PARTICIPACIÓN, APROBACIÓN..."
                                    Style="{DynamicResource CertificateEntry}"
                                    Text="{Binding CertificateType}" />
                            </Border>
                            <Label
                                Style="{DynamicResource CertificateFieldLabel}"
                                Text="Texto común" />
                            <Border
                                Padding="10,6"
                                Style="{DynamicResource CertificateInputBorder}">
                                <Editor
                                    AutoSize="Disabled"
                                    Placeholder="Usa {cedula} donde deba aparecer la identificación."
                                    Style="{DynamicResource CertificateEditor}"
                                    Text="{Binding BodyTemplate}" />
                            </Border>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Button Style="{DynamicResource SecondaryAction}"
                                    Command="{Binding InsertIdentificationTokenCommand}"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Padding="10,6"
                                    Text="Insertar {cedula}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="Segoe UI"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding BodyPreviewText}"
                                    TextColor="{DynamicResource SecondaryText}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Style="{DynamicResource CertificateFieldLabel}"
                                        Text="Fecha del encabezado"
                                        />
                                    <Border Style="{DynamicResource CertificateInputBorder}">
                                        <DatePicker
                                            Date="{Binding CertificateDate}"
                                            Style="{DynamicResource CertificateDatePicker}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label
                                        Style="{DynamicResource CertificateFieldLabel}"
                                        Text="Último folio utilizado"
                                        />
                                    <Border Style="{DynamicResource CertificateInputBorder}">
                                        <Entry
                                            Keyboard="Numeric"
                                            Style="{DynamicResource CertificateEntry}"
                                            Text="{Binding LastUsedFolioText}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="{DynamicResource SmallFontSize}"
                                Text="{Binding FolioRangeText}"
                                TextColor="{DynamicResource WarningText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14">
                    <Border IsVisible="{Binding HasGenerationFields}" BackgroundColor="{DynamicResource SurfaceBackground}" Padding="16" Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Datos adicionales de la plantilla" FontSize="20" />
                            <Label Text="Completa estos datos para este lote. Cada firma tiene su propia imagen PNG." />
                            <Label Text="Los textos admiten variables como {nombre}, {cedula}, {folio} y {fecha}, que se reemplazan para cada participante." FontSize="{DynamicResource SmallFontSize}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding GenerationFields}" Spacing="14">
                                <BindableLayout.ItemTemplate><DataTemplate>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Editor IsVisible="{Binding IsText}" Text="{Binding Value}" Placeholder="Completa este dato" AutoSize="TextChanges" MinimumHeightRequest="70" />
                                        <VerticalStackLayout IsVisible="{Binding IsSignature}" Spacing="6">
                                            <Button Text="Seleccionar PNG" Command="{Binding PickImageCommand}" Style="{DynamicResource SecondaryAction}" HorizontalOptions="Start" />
                                            <Label Text="{Binding Status}" />
                                            <Image Source="{Binding ImagePath}" IsVisible="{Binding HasImage}" HeightRequest="85" Aspect="AspectFit" HorizontalOptions="Start" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate></BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border IsVisible="{Binding HasMainSigner}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        Padding="16"
                        Stroke="{DynamicResource OutlineColor}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="9">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="16"
                                Text="Firma"
                                TextColor="{DynamicResource PrimaryText}" />
                            <Label
                                Style="{DynamicResource CertificateFieldLabel}"
                                Text="Nombre del firmante" IsVisible="{Binding UsesSignerName}" />
                            <Border IsVisible="{Binding UsesSignerName}" Style="{DynamicResource CertificateInputBorder}">
                                <Entry
                                    Placeholder="Nombre y apellidos"
                                    Style="{DynamicResource CertificateEntry}"
                                    Text="{Binding SignerName}" />
                            </Border>
                            <Label
                                Style="{DynamicResource CertificateFieldLabel}"
                                Text="Título o cargo" IsVisible="{Binding UsesSignerTitle}" />
                            <Border IsVisible="{Binding UsesSignerTitle}" Style="{DynamicResource CertificateInputBorder}">
                                <Entry
                                    Placeholder="Ej.: Instructor del curso"
                                    Style="{DynamicResource CertificateEntry}"
                                    Text="{Binding SignerTitle}" />
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding UsesMainSignature}" Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Button Style="{DynamicResource SecondaryAction}"
                                    Command="{Binding PickSignatureCommand}"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Text="Seleccionar PNG" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="Segoe UI"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding SignatureFileName}"
                                    TextColor="{DynamicResource SecondaryText}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Border
                                BackgroundColor="{DynamicResource InputBackground}"
                                HeightRequest="90"
                                IsVisible="{Binding HasSignature}"
                                Stroke="{DynamicResource OutlineColor}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1">
                                <Image
                                    Aspect="AspectFit"
                                    Margin="8"
                                    Source="{Binding SignaturePath}" />
                            </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        Padding="16"
                        Stroke="{DynamicResource OutlineColor}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="16"
                                Text="Salida"
                                TextColor="{DynamicResource PrimaryText}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button
                                    BackgroundColor="{Binding CombinedOutputBackground}"
                                    Command="{Binding SelectCombinedOutputCommand}"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Text="Un solo PDF"
                                    TextColor="{Binding CombinedOutputTextColor}" />
                                <Button
                                    Grid.Column="1"
                                    BackgroundColor="{Binding SeparateOutputBackground}"
                                    Command="{Binding SelectSeparateOutputCommand}"
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Text="Archivos separados"
                                    TextColor="{Binding SeparateOutputTextColor}" />
                            </Grid>
                            <Button Style="{DynamicResource SecondaryAction}"
                                Command="{Binding PickOutputDirectoryCommand}"
                                Text="Seleccionar carpeta de salida" />
                            <Label
                                FontFamily="Segoe UI"
                                FontSize="{DynamicResource SmallFontSize}"
                                LineBreakMode="TailTruncation"
                                Text="{Binding OutputDirectoryText}"
                                TextColor="{DynamicResource SecondaryText}" />
                            <Label
                                FontFamily="Segoe UI"
                                FontSize="{DynamicResource SmallFontSize}"
                                Text="Separados: folio_nombre.pdf. Combinado: Certificados_inicio-fin.pdf."
                                TextColor="{DynamicResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <ScrollView MaximumHeightRequest="110"><Label Text="{Binding GenerationStatus}" SemanticProperties.Description="Estado de generación" /></ScrollView>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Revisa la plantilla y los datos antes de generar." VerticalOptions="Center"/><Button Grid.Column="1" Text="Generar certificados" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Style="{DynamicResource PrimaryAction}" /></Grid>
            <controls:ResultActionsView BindingContext="{Binding Results}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
