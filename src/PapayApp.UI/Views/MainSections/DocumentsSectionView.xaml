<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.DocumentsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Padding="36"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="12">
        <Label
            x:Name="DocumentsTitle"
            IsVisible="{Binding ShowDocumentControls}"
            FontFamily="Segoe UI Semibold"
            FontSize="28"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Text="Area Generadora"
            TextColor="#000000" />

        <VerticalStackLayout
            x:Name="DocumentControls"
            Grid.Row="1"
            IsVisible="{Binding ShowDocumentControls}"
            Spacing="10">
            <Grid
                ColumnDefinitions="*,*,*,*"
                ColumnSpacing="10">
                <Border
                    x:Name="PeriodicaOptionBorder"
                    BackgroundColor="{Binding PeriodicaButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodicaCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="PERIODICA"
                        TextColor="{Binding PeriodicaTextColor}" />
                </Border>

                <Border
                    x:Name="PreocupacionalOptionBorder"
                    Grid.Column="1"
                    BackgroundColor="{Binding PreocupacionalButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPreocupacionalCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="PREOCUPACIONAL"
                        TextColor="{Binding PreocupacionalTextColor}" />
                </Border>

                <Border
                    x:Name="ReintegroOptionBorder"
                    Grid.Column="2"
                    BackgroundColor="{Binding ReintegroButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectReintegroCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="REINTEGRO"
                        TextColor="{Binding ReintegroTextColor}" />
                </Border>

                <Border
                    x:Name="RetiroOptionBorder"
                    Grid.Column="3"
                    BackgroundColor="{Binding RetiroButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectRetiroCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="RETIRO"
                        TextColor="{Binding RetiroTextColor}" />
                </Border>
            </Grid>

            <Border
                BackgroundColor="#FFFFFF"
                Padding="14"
                Stroke="#DCECF4"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="14"
                        Text="Datos de generación"
                        TextColor="#173753" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label
                            FontFamily="Segoe UI Semibold"
                            FontSize="11"
                            Text="Fecha de atención"
                            TextColor="#36586B"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                            <Label
                                FontFamily="Segoe UI"
                                FontSize="11"
                                Text="Incluir fecha"
                                TextColor="#36586B"
                                VerticalOptions="Center" />
                            <Switch
                                IsToggled="{Binding IncludeMedicalAttentionDate, Mode=TwoWay}"
                                OnColor="#2892D7"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border
                        BackgroundColor="#F4FAFD"
                        Padding="10,0"
                        Stroke="#AFC7D4"
                        StrokeShape="RoundRectangle 7"
                        StrokeThickness="1">
                        <DatePicker
                            BackgroundColor="Transparent"
                            Date="{Binding MedicalAttentionDate, Mode=TwoWay}"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Format="dd/MM/yyyy"
                            HeightRequest="40"
                            IsEnabled="{Binding IsMedicalAttentionDateEnabled}"
                            TextColor="#173753" />
                    </Border>

                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="11"
                        Text="Empresa"
                        TextColor="#36586B" />

                    <Picker
                        BackgroundColor="#F4FAFD"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        ItemDisplayBinding="{Binding DisplayName}"
                        ItemsSource="{Binding Companies}"
                        SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                        TextColor="#173753"
                        Title="Selecciona una empresa"
                        TitleColor="#36586B" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">
                        <Button
                            BackgroundColor="#173753"
                            Command="{Binding RegisterCompanyCommand}"
                            FontFamily="Segoe UI Semibold"
                            FontSize="12"
                            Padding="12,8"
                            Text="Registrar nueva empresa"
                            TextColor="White" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="#FFF1F2"
                            Command="{Binding DeleteCompanyCommand}"
                            FontFamily="Segoe UI Semibold"
                            FontSize="12"
                            IsEnabled="{Binding CanDeleteCompany}"
                            Padding="12,8"
                            Text="Eliminar empresa"
                            TextColor="#B42318" />
                    </Grid>

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10">
                        <Button
                            BackgroundColor="#F4FAFD"
                            Command="{Binding PickLogoCommand}"
                            FontFamily="Segoe UI Semibold"
                            FontSize="12"
                            Padding="12,8"
                            Text="Seleccionar logotipo PNG/JPEG"
                            TextColor="#173753" />
                        <Label
                            Grid.Column="1"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            Text="{Binding SelectedLogoDisplayText}"
                            TextColor="#36586B"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="2"
                            BackgroundColor="#FFF1F2"
                            Command="{Binding ClearLogoCommand}"
                            FontFamily="Segoe UI Semibold"
                            FontSize="12"
                            IsVisible="{Binding HasSelectedLogo}"
                            Padding="12,8"
                            Text="Quitar"
                            TextColor="#B42318" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="UploadDropArea"
                IsVisible="{Binding ShowUploadArea}"
                BackgroundColor="#F4FAFD"
                Padding="14"
                Stroke="#6DAEDB"
                StrokeDashArray="8,6"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickUploadFileCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">
                    <Image
                        HeightRequest="36"
                        Source="up_loading.png"
                        WidthRequest="36" />
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        Text="{Binding UploadAreaTitle}"
                        TextColor="#000000" />
                    <Label
                        FontFamily="Segoe UI"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="{Binding UploadAreaSubtitle}"
                        TextColor="#1B4353" />
                </VerticalStackLayout>
            </Border>

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                IsVisible="{Binding HasSelectedUploadFile}">
                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    LineBreakMode="TailTruncation"
                    Text="{Binding SelectedUploadFileName}"
                    TextColor="#36586B"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    BackgroundColor="#F4FAFD"
                    Command="{Binding ChangeMasterFileCommand}"
                    FontSize="12"
                    Padding="12,6"
                    Text="Cambiar archivo maestro"
                    TextColor="#173753" />
            </Grid>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#2892D7" />
        </VerticalStackLayout>

        <Border
            x:Name="ImportStatusPanel"
            Grid.Row="2"
            IsVisible="{Binding ShowDocumentControls}"
            BackgroundColor="#FFFFFF"
            Padding="12,8"
            Stroke="#DCECF4"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="{Binding StatusMessage}"
                    TextColor="#36586B" />
                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ImportSummaryText}"
                    TextColor="#173753" />
            </VerticalStackLayout>
        </Border>

        <Border
            x:Name="PreviewPanel"
            Grid.Row="3"
            BackgroundColor="#FFFFFF"
            Padding="0"
            Stroke="#DCECF4"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Grid
                    Padding="12,10,12,8"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto">
                    <Entry
                        Grid.Row="0"
                        Grid.Column="0"
                        ClearButtonVisibility="WhileEditing"
                        Placeholder="Buscar por nombre o cedula"
                        Text="{Binding PreviewSearchText}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Text="{Binding PreviewResultsCountText}"
                        TextColor="#36586B" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="#F4FAFD"
                        Clicked="OnTogglePreviewExpandedClicked"
                        FontFamily="Segoe UI Semibold"
                        FontSize="16"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        MinimumWidthRequest="36"
                        Padding="8,0"
                        Text="{Binding PreviewExpandButtonText}"
                        TextColor="#173753"
                        VerticalOptions="Fill" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout
                        Padding="12,0,12,12"
                        BindableLayout.ItemsSource="{Binding PreviewRecords}"
                        Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="#FFFFFF"
                                    Padding="10,8"
                                    Stroke="#DCECF4"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleSelectionCommand}"
                                            NumberOfTapsRequired="2" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8">
                                            <CheckBox
                                                IsChecked="{Binding IsSelected}"
                                                IsEnabled="{Binding CanGenerate}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Segoe UI Semibold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding FullNameDisplay}"
                                                TextColor="#173753"
                                                VerticalOptions="Center" />
                                            <HorizontalStackLayout
                                                Grid.Column="2"
                                                Spacing="4">
                                                <Button
                                                    Style="{StaticResource GenderChip}"
                                                    BackgroundColor="{Binding MaleButtonBackground}"
                                                    Command="{Binding SelectMaleCommand}"
                                                    Text="H"
                                                    TextColor="{Binding MaleButtonTextColor}" />
                                                <Button
                                                    Style="{StaticResource GenderChip}"
                                                    BackgroundColor="{Binding FemaleButtonBackground}"
                                                    Command="{Binding SelectFemaleCommand}"
                                                    Text="M"
                                                    TextColor="{Binding FemaleButtonTextColor}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">
                                            <Label
                                                FontFamily="Segoe UI"
                                                FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding RowSummary}"
                                                TextColor="#36586B" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Segoe UI"
                                                FontSize="11"
                                                Text="{Binding StatusText}"
                                                TextColor="#36586B" />
                                        </Grid>

                                        <Label
                                            FontFamily="Segoe UI"
                                            FontSize="11"
                                            IsVisible="{Binding HasWarnings}"
                                            Text="{Binding WarningsText}"
                                            TextColor="#8C2F39" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <VerticalStackLayout
            Grid.Row="4"
            Spacing="12">
            <Border
                x:Name="PreGenerationSummary"
                IsVisible="{Binding ShowPreGenerationSummary}"
                BackgroundColor="#FFFFFF"
                Padding="14"
                Stroke="#DCECF4"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Text="{Binding PreGenerationSummaryText}"
                    TextColor="#173753" />
            </Border>

            <Button
                BackgroundColor="#2F9E44"
                Command="{Binding GenerateFilesCommand}"
                HorizontalOptions="Fill"
                IsEnabled="{Binding CanGenerate}"
                Text="Generar archivos"
                TextColor="White" />

            <Border
                IsVisible="{Binding HasGenerationSummary}"
                BackgroundColor="#FFFFFF"
                Padding="14"
                Stroke="#DCECF4"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Text="{Binding GenerationSummaryText}"
                    TextColor="#173753" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>
