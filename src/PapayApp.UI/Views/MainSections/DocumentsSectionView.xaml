<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.DocumentsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PapayApp.UI.Controls">
    <Grid Padding="{DynamicResource PagePadding}" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{DynamicResource SectionGap}">
        <controls:PageHeaderView x:Name="DocumentsTitle" IsVisible="{Binding ShowDocumentControls}" Title="Evaluaciones médicas" Subtitle="Configura el documento y selecciona las personas del reporte maestro." />
        <Grid x:Name="GeneratorWorkspace" Grid.Row="1" ColumnDefinitions="340,*"
              ColumnSpacing="{DynamicResource SectionGap}" RowSpacing="{DynamicResource ControlGap}" SizeChanged="OnWorkspaceSizeChanged">
            <ScrollView x:Name="ConfigurationScroll" IsVisible="{Binding ShowDocumentControls}">
                <VerticalStackLayout Spacing="{DynamicResource ControlGap}" Padding="0,0,4,4">
                    <VerticalStackLayout x:Name="DocumentControls" IsVisible="{Binding ShowDocumentControls}" Spacing="{DynamicResource ControlGap}">
                        <Border BackgroundColor="{DynamicResource SurfaceBackground}" Padding="{DynamicResource CardPadding}"
                                Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="{DynamicResource ControlGap}">
                                <Label Style="{DynamicResource SectionTitle}" Text="1. Tipo de evaluación" />
                                <Label Style="{DynamicResource HelpText}" Text="{Binding SelectedEvaluationText}" />
                                <Grid
                                    ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FieldGap}"
                                    ColumnSpacing="{DynamicResource ControlGap}">
                                    <Button x:Name="PeriodicaOptionBorder" Text="Periódica" Command="{Binding SelectPeriodicaCommand}" BackgroundColor="{Binding PeriodicaButtonBackground}" TextColor="{Binding PeriodicaTextColor}" SemanticProperties.Description="Tipo de evaluación: Periódica" />

                                    <Button x:Name="PreocupacionalOptionBorder" Grid.Column="1" Text="Preocupacional" Command="{Binding SelectPreocupacionalCommand}" BackgroundColor="{Binding PreocupacionalButtonBackground}" TextColor="{Binding PreocupacionalTextColor}" SemanticProperties.Description="Tipo de evaluación: Preocupacional" />

                                    <Button x:Name="ReintegroOptionBorder" Grid.Row="1" Text="Reintegro" Command="{Binding SelectReintegroCommand}" BackgroundColor="{Binding ReintegroButtonBackground}" TextColor="{Binding ReintegroTextColor}" SemanticProperties.Description="Tipo de evaluación: Reintegro" />

                                    <Button x:Name="RetiroOptionBorder" Grid.Column="1" Grid.Row="1" Text="Retiro" Command="{Binding SelectRetiroCommand}" BackgroundColor="{Binding RetiroButtonBackground}" TextColor="{Binding RetiroTextColor}" SemanticProperties.Description="Tipo de evaluación: Retiro" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="{DynamicResource SurfaceBackground}" Padding="{DynamicResource CardPadding}"
                                Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="{DynamicResource ControlGap}">
                                <Label Style="{DynamicResource SectionTitle}" Text="2. Datos del documento" />
                                <Label Style="{DynamicResource FieldLabel}" Text="Empresa" />
                                <Picker Title="Selecciona una empresa" FontSize="{DynamicResource BodyFontSize}"
                                        ItemsSource="{Binding Companies}" ItemDisplayBinding="{Binding DisplayName}"
                                        SelectedItem="{Binding SelectedCompany, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource FieldGap}">
                                    <Label Style="{DynamicResource FieldLabel}" Text="Incluir fecha de atención" VerticalOptions="Center"
                                           />
                                    <Switch Grid.Column="1" IsToggled="{Binding IncludeMedicalAttentionDate, Mode=TwoWay}" />
                                </Grid>
                                <DatePicker Date="{Binding MedicalAttentionDate, Mode=TwoWay}" Format="dd/MM/yyyy"
                                            FontSize="{DynamicResource BodyFontSize}" IsVisible="{Binding IsMedicalAttentionDateEnabled}" />
                                <Button Style="{DynamicResource SecondaryAction}" Text="Empresa y logotipo ▾" Clicked="OnToggleCompanyOptionsClicked" Padding="10,8" />
                                <VerticalStackLayout x:Name="CompanyOptions" IsVisible="False" Spacing="{DynamicResource FieldGap}">
                                    <Button Style="{DynamicResource SecondaryAction}" Text="Registrar empresa" Command="{Binding RegisterCompanyCommand}" Padding="10,8" />
                                    <Button Style="{DynamicResource DestructiveAction}" Text="Eliminar empresa seleccionada" Command="{Binding DeleteCompanyCommand}"
                                            IsEnabled="{Binding CanDeleteCompany}" Padding="10,8" />
                                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource OutlineColor}" Margin="0,4" />
                                    <Label Style="{DynamicResource HelpText}" Text="Logotipo opcional · PNG o JPEG" TextColor="{DynamicResource SecondaryText}" />
                                    <Label Style="{DynamicResource HelpText}" Text="{Binding SelectedLogoDisplayText}" LineBreakMode="TailTruncation"
                                           TextColor="{DynamicResource SecondaryText}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource FieldGap}">
                                        <Button Style="{DynamicResource SecondaryAction}" Text="Seleccionar logotipo" Command="{Binding PickLogoCommand}" Padding="10,8" />
                                        <Button Style="{DynamicResource DestructiveAction}" Grid.Column="1" Text="Quitar" Command="{Binding ClearLogoCommand}"
                                                IsVisible="{Binding HasSelectedLogo}" Padding="10,8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Spacing="{DynamicResource ControlGap}">
                            <Label Style="{DynamicResource SectionTitle}" Text="3. Reporte maestro" />
                            <Border x:Name="UploadDropArea" IsVisible="{Binding ShowUploadArea}"
                                    BackgroundColor="{DynamicResource InputBackground}" Padding="{DynamicResource CardPadding}"
                                    Stroke="{DynamicResource AccentColor}" StrokeDashArray="8,6"
                                    StrokeShape="RoundRectangle 8" StrokeThickness="2">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickUploadFileCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="{DynamicResource FieldGap}">
                                    <Image HeightRequest="24" WidthRequest="24" Source="up_loading.png" />
                                    <Label Style="{DynamicResource FieldLabel}" Text="{Binding UploadAreaTitle}" HorizontalTextAlignment="Center" />
                                    <Label Style="{DynamicResource HelpText}" Text="{Binding UploadAreaSubtitle}" HorizontalTextAlignment="Center" TextColor="{DynamicResource SecondaryText}" />
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding HasSelectedUploadFile}" Spacing="{DynamicResource FieldGap}">
                                <Label Style="{DynamicResource HelpText}" Text="{Binding SelectedUploadFileName}" LineBreakMode="TailTruncation" TextColor="{DynamicResource SecondaryText}" />
                                <Button Style="{DynamicResource SecondaryAction}" Text="Cambiar archivo maestro" Command="{Binding ChangeMasterFileCommand}" Padding="10,8" />
                            </VerticalStackLayout>
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource AccentColor}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Border x:Name="ImportStatusPanel" IsVisible="{Binding ShowDocumentControls}"
                            BackgroundColor="{DynamicResource SurfaceBackground}" Padding="12"
                            Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="{DynamicResource FieldGap}">
                            <Label Style="{DynamicResource HelpText}" Text="{Binding StatusMessage}" TextColor="{DynamicResource SecondaryText}" />
                            <Label Style="{DynamicResource HelpText}" Text="{Binding ImportSummaryText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="PreGenerationSummary" IsVisible="{Binding ShowPreGenerationSummary}"
                            BackgroundColor="{DynamicResource SurfaceBackground}" Padding="12"
                            Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="{DynamicResource FieldGap}">
                            <Label Style="{DynamicResource SectionTitle}" Text="Resumen de generación" />
                            <Label Style="{DynamicResource HelpText}" Text="{Binding PreGenerationSummaryText}" TextColor="{DynamicResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        <Border
            x:Name="PreviewPanel"
            Grid.Column="1"
            BackgroundColor="{DynamicResource SurfaceBackground}"
            Padding="0"
            Stroke="{DynamicResource OutlineColor}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding ShowDocumentControls}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                </DataTrigger>
            </Border.Triggers>
            <Grid RowDefinitions="Auto,*">
                <Grid
                    Padding="{DynamicResource CardPadding}"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{DynamicResource FieldGap}"
                    RowDefinitions="Auto,Auto,Auto">
                    <Label Style="{DynamicResource SectionTitle}" Text="4. Revisa y selecciona las personas" TextColor="{DynamicResource PrimaryText}" Margin="0,0,0,8" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="0"
                        ClearButtonVisibility="WhileEditing"
                        Placeholder="Buscar por nombre o cedula"
                        Text="{Binding PreviewSearchText}" />
                    <Label Style="{DynamicResource HelpText}"
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="{Binding PreviewResultsCountText}"
                        TextColor="{DynamicResource SecondaryText}" />
                    <Button Style="{DynamicResource SecondaryAction}"
                        Grid.Row="0"
                        Grid.Column="1"
                        Clicked="OnTogglePreviewExpandedClicked"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        MinimumWidthRequest="36"
                        Padding="8,0"
                        Text="{Binding PreviewExpandButtonText}"
                        VerticalOptions="Fill" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout
                        Padding="12,0,12,12"
                        BindableLayout.ItemsSource="{Binding PreviewRecords}"
                        Spacing="{DynamicResource FieldGap}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="{DynamicResource SurfaceBackground}"
                                    Padding="10,8"
                                    Stroke="{DynamicResource OutlineColor}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleSelectionCommand}"
                                            NumberOfTapsRequired="2" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="{DynamicResource FieldGap}">
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="{DynamicResource FieldGap}">
                                            <CheckBox
                                                IsChecked="{Binding IsSelected}"
                                                IsEnabled="{Binding CanGenerate}"
                                                VerticalOptions="Center" />
                                            <Label Style="{DynamicResource FieldLabel}"
                                                Grid.Column="1"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding FullNameDisplay}"
                                                TextColor="{DynamicResource PrimaryText}"
                                                VerticalOptions="Center" />
                                            <HorizontalStackLayout
                                                Grid.Column="2"
                                                Spacing="{DynamicResource FieldGap}">
                                                <Button
                                                    Style="{DynamicResource GenderChip}"
                                                    BackgroundColor="{Binding MaleButtonBackground}"
                                                    Command="{Binding SelectMaleCommand}"
                                                    Text="H"
                                                    TextColor="{Binding MaleButtonTextColor}" />
                                                <Button
                                                    Style="{DynamicResource GenderChip}"
                                                    BackgroundColor="{Binding FemaleButtonBackground}"
                                                    Command="{Binding SelectFemaleCommand}"
                                                    Text="M"
                                                    TextColor="{Binding FemaleButtonTextColor}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="{DynamicResource FieldGap}">
                                            <Label Style="{DynamicResource HelpText}"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding RowSummary}"
                                                TextColor="{DynamicResource SecondaryText}" />
                                            <Label Style="{DynamicResource HelpText}"
                                                Grid.Column="1"
                                                Text="{Binding StatusText}"
                                                TextColor="{DynamicResource SecondaryText}" />
                                        </Grid>

                                        <Label Style="{DynamicResource HelpText}"
                                            IsVisible="{Binding HasWarnings}"
                                            Text="{Binding WarningsText}"
                                            TextColor="{DynamicResource DangerText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>


        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SectionGap}">
            <Label Style="{DynamicResource HelpText}" Text="Selecciona las personas y revisa los datos antes de generar." TextColor="{DynamicResource SecondaryText}" VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasGenerationSummary}" Value="True">
                        <Setter Property="Text" Value="{Binding GenerationSummaryText}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Button Style="{DynamicResource PrimaryAction}" Grid.Column="1" Text="Generar archivos" Command="{Binding GenerateFilesCommand}"
                    IsEnabled="{Binding CanGenerate}" MinimumWidthRequest="180" />
        </Grid>
        <controls:ResultActionsView Grid.Row="3" BindingContext="{Binding Results}" />
    </Grid>
</ContentView>
