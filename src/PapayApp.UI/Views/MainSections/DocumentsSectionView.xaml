<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.DocumentsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ScrollView>
        <VerticalStackLayout
            Padding="36"
            Spacing="18">
            <Label
                FontFamily="Segoe UI Semibold"
                FontSize="28"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Area Generadora"
                TextColor="#000000" />

            <Grid
                ColumnDefinitions="*,*,*,*"
                ColumnSpacing="10">
                <Border
                    x:Name="PeriodicaOptionBorder"
                    BackgroundColor="{Binding PeriodicaButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodicaCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="PERIODICA"
                        TextColor="{Binding PeriodicaTextColor}" />
                </Border>

                <Border
                    x:Name="PreocupacionalOptionBorder"
                    Grid.Column="1"
                    BackgroundColor="{Binding PreocupacionalButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPreocupacionalCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="PREOCUPACIONAL"
                        TextColor="{Binding PreocupacionalTextColor}" />
                </Border>

                <Border
                    x:Name="ReintegroOptionBorder"
                    Grid.Column="2"
                    BackgroundColor="{Binding ReintegroButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectReintegroCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="REINTEGRO"
                        TextColor="{Binding ReintegroTextColor}" />
                </Border>

                <Border
                    x:Name="RetiroOptionBorder"
                    Grid.Column="3"
                    BackgroundColor="{Binding RetiroButtonBackground}"
                    Padding="12,10"
                    Stroke="#DCECF4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectRetiroCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="RETIRO"
                        TextColor="{Binding RetiroTextColor}" />
                </Border>
            </Grid>

            <Border
                x:Name="UploadDropArea"
                IsVisible="{Binding ShowUploadArea}"
                BackgroundColor="#F4FAFD"
                Padding="24"
                Stroke="#6DAEDB"
                StrokeDashArray="8,6"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickUploadFileCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">
                    <Image
                        HeightRequest="56"
                        Source="up_loading.png"
                        WidthRequest="56" />
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="{Binding UploadAreaTitle}"
                        TextColor="#000000" />
                    <Label
                        FontFamily="Segoe UI"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="{Binding UploadAreaSubtitle}"
                        TextColor="#1B4353" />
                </VerticalStackLayout>
            </Border>

            <Button
                BackgroundColor="#F4FAFD"
                Command="{Binding ChangeMasterFileCommand}"
                HorizontalOptions="Center"
                IsVisible="{Binding HasSelectedUploadFile}"
                Text="Cambiar Archivo Maestro"
                TextColor="#173753" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#2892D7" />

            <Border
                BackgroundColor="#FFFFFF"
                Padding="16"
                Stroke="#DCECF4"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="Segoe UI"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="{Binding StatusMessage}"
                        TextColor="#36586B" />
                    <Label
                        FontFamily="Segoe UI"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="{Binding ImportSummaryText}"
                        TextColor="#173753" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding PreviewRecords}"
                Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#FFFFFF"
                            Padding="16"
                            Stroke="#DCECF4"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="10">
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="10">
                                    <CheckBox
                                        IsChecked="{Binding IsSelected}"
                                        IsEnabled="{Binding CanGenerate}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="15"
                                            Text="{Binding FullNameDisplay}"
                                            TextColor="#173753" />
                                        <Label
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            Text="{Binding RowSummary}"
                                            TextColor="#36586B" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Text="{Binding StatusText}"
                                        TextColor="#36586B" />
                                </Grid>

                                <HorizontalStackLayout Spacing="8">
                                    <Button
                                        Style="{StaticResource GenderChip}"
                                        BackgroundColor="{Binding MaleButtonBackground}"
                                        Command="{Binding SelectMaleCommand}"
                                        Text="H"
                                        TextColor="{Binding MaleButtonTextColor}" />
                                    <Button
                                        Style="{StaticResource GenderChip}"
                                        BackgroundColor="{Binding FemaleButtonBackground}"
                                        Command="{Binding SelectFemaleCommand}"
                                        Text="M"
                                        TextColor="{Binding FemaleButtonTextColor}" />
                                    <Label
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Text="{Binding GenderText}"
                                        TextColor="#36586B"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label
                                    FontFamily="Segoe UI"
                                    FontSize="12"
                                    IsVisible="{Binding HasWarnings}"
                                    Text="{Binding WarningsText}"
                                    TextColor="#8C2F39" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                BackgroundColor="#2F9E44"
                Command="{Binding GenerateFilesCommand}"
                HorizontalOptions="Fill"
                IsEnabled="{Binding CanGenerate}"
                Text="Generar archivos"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
