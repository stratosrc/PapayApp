<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.DocumentsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid Padding="24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <Label x:Name="DocumentsTitle" IsVisible="{Binding ShowDocumentControls}"
               Text="Área generadora" FontFamily="Segoe UI Semibold" FontSize="26"
               TextColor="{StaticResource PrimaryText}" />
        <Grid x:Name="GeneratorWorkspace" Grid.Row="1" ColumnDefinitions="340,*"
              ColumnSpacing="16" RowSpacing="12" SizeChanged="OnWorkspaceSizeChanged">
            <ScrollView x:Name="ConfigurationScroll" IsVisible="{Binding ShowDocumentControls}">
                <VerticalStackLayout Spacing="12" Padding="0,0,4,4">
                    <VerticalStackLayout x:Name="DocumentControls" IsVisible="{Binding ShowDocumentControls}" Spacing="12">
                        <Border BackgroundColor="{StaticResource SurfaceBackground}" Padding="14"
                                Stroke="{StaticResource OutlineColor}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="1. Tipo de evaluación" FontFamily="Segoe UI Semibold" FontSize="14" />
                                <Grid
                                    ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8"
                                    ColumnSpacing="10">
                                    <Border
                                        x:Name="PeriodicaOptionBorder"
                                        BackgroundColor="{Binding PeriodicaButtonBackground}"
                                        Padding="12,10"
                                        Stroke="{StaticResource OutlineColor}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectPeriodicaCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Text="PERIODICA"
                                            TextColor="{Binding PeriodicaTextColor}" />
                                    </Border>

                                    <Border
                                        x:Name="PreocupacionalOptionBorder"
                                        Grid.Column="1"
                                        BackgroundColor="{Binding PreocupacionalButtonBackground}"
                                        Padding="12,10"
                                        Stroke="{StaticResource OutlineColor}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectPreocupacionalCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Text="PREOCUPACIONAL"
                                            TextColor="{Binding PreocupacionalTextColor}" />
                                    </Border>

                                    <Border
                                        x:Name="ReintegroOptionBorder"
                                        Grid.Row="1"
                                        BackgroundColor="{Binding ReintegroButtonBackground}"
                                        Padding="12,10"
                                        Stroke="{StaticResource OutlineColor}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectReintegroCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Text="REINTEGRO"
                                            TextColor="{Binding ReintegroTextColor}" />
                                    </Border>

                                    <Border
                                        x:Name="RetiroOptionBorder"
                                        Grid.Row="1" Grid.Column="1"
                                        BackgroundColor="{Binding RetiroButtonBackground}"
                                        Padding="12,10"
                                        Stroke="{StaticResource OutlineColor}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectRetiroCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Text="RETIRO"
                                            TextColor="{Binding RetiroTextColor}" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="{StaticResource SurfaceBackground}" Padding="14"
                                Stroke="{StaticResource OutlineColor}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="2. Datos del documento" FontFamily="Segoe UI Semibold" FontSize="14" />
                                <Label Text="Empresa" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                                <Picker Title="Selecciona una empresa" FontSize="13"
                                        ItemsSource="{Binding Companies}" ItemDisplayBinding="{Binding DisplayName}"
                                        SelectedItem="{Binding SelectedCompany, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Incluir fecha de atención" FontSize="12" VerticalOptions="Center"
                                           TextColor="{StaticResource SecondaryText}" />
                                    <Switch Grid.Column="1" IsToggled="{Binding IncludeMedicalAttentionDate, Mode=TwoWay}" />
                                </Grid>
                                <DatePicker Date="{Binding MedicalAttentionDate, Mode=TwoWay}" Format="dd/MM/yyyy"
                                            FontSize="13" IsVisible="{Binding IsMedicalAttentionDateEnabled}" />
                                <Button Text="Empresa y logotipo ▾" Clicked="OnToggleCompanyOptionsClicked"
                                        BackgroundColor="{StaticResource InputBackground}" FontSize="12" Padding="10,8" />
                                <VerticalStackLayout x:Name="CompanyOptions" IsVisible="False" Spacing="8">
                                    <Button Text="Registrar empresa" Command="{Binding RegisterCompanyCommand}" FontSize="12" Padding="10,8" />
                                    <Button Text="Eliminar empresa seleccionada" Command="{Binding DeleteCompanyCommand}"
                                            IsEnabled="{Binding CanDeleteCompany}" FontSize="12" Padding="10,8"
                                            BackgroundColor="{StaticResource DangerBackground}" TextColor="{StaticResource DangerText}" />
                                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineColor}" Margin="0,4" />
                                    <Label Text="Logotipo opcional · PNG o JPEG" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding SelectedLogoDisplayText}" FontSize="12" LineBreakMode="TailTruncation"
                                           TextColor="{StaticResource SecondaryText}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Button Text="Seleccionar logotipo" Command="{Binding PickLogoCommand}" FontSize="12" Padding="10,8"
                                                BackgroundColor="{StaticResource InputBackground}" />
                                        <Button Grid.Column="1" Text="Quitar" Command="{Binding ClearLogoCommand}"
                                                IsVisible="{Binding HasSelectedLogo}" FontSize="12" Padding="10,8"
                                                BackgroundColor="{StaticResource DangerBackground}" TextColor="{StaticResource DangerText}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="3. Reporte maestro" FontFamily="Segoe UI Semibold" FontSize="14" />
                            <Border x:Name="UploadDropArea" IsVisible="{Binding ShowUploadArea}"
                                    BackgroundColor="{StaticResource InputBackground}" Padding="14"
                                    Stroke="{StaticResource AccentColor}" StrokeDashArray="8,6"
                                    StrokeShape="RoundRectangle 8" StrokeThickness="2">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickUploadFileCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Image HeightRequest="24" WidthRequest="24" Source="up_loading.png" />
                                    <Label Text="{Binding UploadAreaTitle}" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding UploadAreaSubtitle}" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource SecondaryText}" />
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding HasSelectedUploadFile}" Spacing="8">
                                <Label Text="{Binding SelectedUploadFileName}" FontSize="12" LineBreakMode="TailTruncation" TextColor="{StaticResource SecondaryText}" />
                                <Button Text="Cambiar archivo maestro" Command="{Binding ChangeMasterFileCommand}"
                                        BackgroundColor="{StaticResource InputBackground}" FontSize="12" Padding="10,8" />
                            </VerticalStackLayout>
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentColor}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Border x:Name="ImportStatusPanel" IsVisible="{Binding ShowDocumentControls}"
                            BackgroundColor="{StaticResource SurfaceBackground}" Padding="12"
                            Stroke="{StaticResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                            <Label Text="{Binding ImportSummaryText}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="PreGenerationSummary" IsVisible="{Binding ShowPreGenerationSummary}"
                            BackgroundColor="{StaticResource SurfaceBackground}" Padding="12"
                            Stroke="{StaticResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Resumen de generación" FontFamily="Segoe UI Semibold" FontSize="13" />
                            <Label Text="{Binding PreGenerationSummaryText}" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        <Border
            x:Name="PreviewPanel"
            Grid.Column="1"
            BackgroundColor="{StaticResource SurfaceBackground}"
            Padding="0"
            Stroke="{StaticResource OutlineColor}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding ShowDocumentControls}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                </DataTrigger>
            </Border.Triggers>
            <Grid RowDefinitions="Auto,*">
                <Grid
                    Padding="12,10,12,8"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto,Auto">
                    <Label Text="4. Revisa y selecciona las personas" FontFamily="Segoe UI Semibold" FontSize="14" TextColor="{StaticResource PrimaryText}" Margin="0,0,0,8" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="0"
                        ClearButtonVisibility="WhileEditing"
                        Placeholder="Buscar por nombre o cedula"
                        Text="{Binding PreviewSearchText}" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Text="{Binding PreviewResultsCountText}"
                        TextColor="{StaticResource SecondaryText}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="{StaticResource InputBackground}"
                        Clicked="OnTogglePreviewExpandedClicked"
                        FontFamily="Segoe UI Semibold"
                        FontSize="16"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        MinimumWidthRequest="36"
                        Padding="8,0"
                        Text="{Binding PreviewExpandButtonText}"
                        TextColor="{StaticResource PrimaryText}"
                        VerticalOptions="Fill" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout
                        Padding="12,0,12,12"
                        BindableLayout.ItemsSource="{Binding PreviewRecords}"
                        Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    Padding="10,8"
                                    Stroke="{StaticResource OutlineColor}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleSelectionCommand}"
                                            NumberOfTapsRequired="2" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8">
                                            <CheckBox
                                                IsChecked="{Binding IsSelected}"
                                                IsEnabled="{Binding CanGenerate}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Segoe UI Semibold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding FullNameDisplay}"
                                                TextColor="{StaticResource PrimaryText}"
                                                VerticalOptions="Center" />
                                            <HorizontalStackLayout
                                                Grid.Column="2"
                                                Spacing="4">
                                                <Button
                                                    Style="{StaticResource GenderChip}"
                                                    BackgroundColor="{Binding MaleButtonBackground}"
                                                    Command="{Binding SelectMaleCommand}"
                                                    Text="H"
                                                    TextColor="{Binding MaleButtonTextColor}" />
                                                <Button
                                                    Style="{StaticResource GenderChip}"
                                                    BackgroundColor="{Binding FemaleButtonBackground}"
                                                    Command="{Binding SelectFemaleCommand}"
                                                    Text="M"
                                                    TextColor="{Binding FemaleButtonTextColor}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">
                                            <Label
                                                FontFamily="Segoe UI"
                                                FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding RowSummary}"
                                                TextColor="{StaticResource SecondaryText}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Segoe UI"
                                                FontSize="11"
                                                Text="{Binding StatusText}"
                                                TextColor="{StaticResource SecondaryText}" />
                                        </Grid>

                                        <Label
                                            FontFamily="Segoe UI"
                                            FontSize="11"
                                            IsVisible="{Binding HasWarnings}"
                                            Text="{Binding WarningsText}"
                                            TextColor="{StaticResource DangerText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>


        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Label Text="Selecciona las personas y revisa los datos antes de generar."
                   FontSize="12" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasGenerationSummary}" Value="True">
                        <Setter Property="Text" Value="{Binding GenerationSummaryText}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Button Grid.Column="1" Text="Generar archivos" Command="{Binding GenerateFilesCommand}"
                    IsEnabled="{Binding CanGenerate}" BackgroundColor="{StaticResource SuccessBackground}"
                    TextColor="White" MinimumWidthRequest="180" />
        </Grid>
    </Grid>
</ContentView>