<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.DocumentsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PapayApp.UI.Controls">
    <Grid Padding="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
        <Label x:Name="DocumentsTitle" IsVisible="{Binding ShowDocumentControls}"
               Text="Evaluaciones médicas" FontFamily="Segoe UI Semibold" FontSize="26"
               TextColor="{DynamicResource PrimaryText}" />
        <Grid x:Name="GeneratorWorkspace" Grid.Row="1" ColumnDefinitions="340,*"
              ColumnSpacing="16" RowSpacing="12" SizeChanged="OnWorkspaceSizeChanged">
            <ScrollView x:Name="ConfigurationScroll" IsVisible="{Binding ShowDocumentControls}">
                <VerticalStackLayout Spacing="12" Padding="0,0,4,4">
                    <VerticalStackLayout x:Name="DocumentControls" IsVisible="{Binding ShowDocumentControls}" Spacing="12">
                        <Border BackgroundColor="{DynamicResource SurfaceBackground}" Padding="14"
                                Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding SelectedEvaluationText}" FontSize="{DynamicResource SmallFontSize}" />
                                <Label Text="1. Tipo de evaluación" FontFamily="Segoe UI Semibold" FontSize="{DynamicResource BodyFontSize}" />
                                <Grid
                                    ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8"
                                    ColumnSpacing="10">
                                    <Button x:Name="PeriodicaOptionBorder" Text="Periódica" Command="{Binding SelectPeriodicaCommand}" BackgroundColor="{Binding PeriodicaButtonBackground}" TextColor="{Binding PeriodicaTextColor}" SemanticProperties.Description="Tipo de evaluación: Periódica" />

                                    <Button x:Name="PreocupacionalOptionBorder" Grid.Column="1" Text="Preocupacional" Command="{Binding SelectPreocupacionalCommand}" BackgroundColor="{Binding PreocupacionalButtonBackground}" TextColor="{Binding PreocupacionalTextColor}" SemanticProperties.Description="Tipo de evaluación: Preocupacional" />

                                    <Button x:Name="ReintegroOptionBorder" Grid.Row="1" Text="Reintegro" Command="{Binding SelectReintegroCommand}" BackgroundColor="{Binding ReintegroButtonBackground}" TextColor="{Binding ReintegroTextColor}" SemanticProperties.Description="Tipo de evaluación: Reintegro" />

                                    <Button x:Name="RetiroOptionBorder" Grid.Column="1" Grid.Row="1" Text="Retiro" Command="{Binding SelectRetiroCommand}" BackgroundColor="{Binding RetiroButtonBackground}" TextColor="{Binding RetiroTextColor}" SemanticProperties.Description="Tipo de evaluación: Retiro" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="{DynamicResource SurfaceBackground}" Padding="14"
                                Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="2. Datos del documento" FontFamily="Segoe UI Semibold" FontSize="{DynamicResource BodyFontSize}" />
                                <Label Text="Empresa" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource SecondaryText}" />
                                <Picker Title="Selecciona una empresa" FontSize="{DynamicResource BodyFontSize}"
                                        ItemsSource="{Binding Companies}" ItemDisplayBinding="{Binding DisplayName}"
                                        SelectedItem="{Binding SelectedCompany, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Incluir fecha de atención" FontSize="{DynamicResource SmallFontSize}" VerticalOptions="Center"
                                           TextColor="{DynamicResource SecondaryText}" />
                                    <Switch Grid.Column="1" IsToggled="{Binding IncludeMedicalAttentionDate, Mode=TwoWay}" />
                                </Grid>
                                <DatePicker Date="{Binding MedicalAttentionDate, Mode=TwoWay}" Format="dd/MM/yyyy"
                                            FontSize="{DynamicResource BodyFontSize}" IsVisible="{Binding IsMedicalAttentionDateEnabled}" />
                                <Button Style="{DynamicResource SecondaryAction}" Text="Empresa y logotipo â–¾" Clicked="OnToggleCompanyOptionsClicked" FontSize="{DynamicResource SmallFontSize}" Padding="10,8" />
                                <VerticalStackLayout x:Name="CompanyOptions" IsVisible="False" Spacing="8">
                                    <Button Style="{DynamicResource SecondaryAction}" Text="Registrar empresa" Command="{Binding RegisterCompanyCommand}" FontSize="{DynamicResource SmallFontSize}" Padding="10,8" />
                                    <Button Style="{DynamicResource DestructiveAction}" Text="Eliminar empresa seleccionada" Command="{Binding DeleteCompanyCommand}"
                                            IsEnabled="{Binding CanDeleteCompany}" FontSize="{DynamicResource SmallFontSize}" Padding="10,8" />
                                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource OutlineColor}" Margin="0,4" />
                                    <Label Text="Logotipo opcional · PNG o JPEG" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource SecondaryText}" />
                                    <Label Text="{Binding SelectedLogoDisplayText}" FontSize="{DynamicResource SmallFontSize}" LineBreakMode="TailTruncation"
                                           TextColor="{DynamicResource SecondaryText}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Button Style="{DynamicResource SecondaryAction}" Text="Seleccionar logotipo" Command="{Binding PickLogoCommand}" FontSize="{DynamicResource SmallFontSize}" Padding="10,8" />
                                        <Button Style="{DynamicResource DestructiveAction}" Grid.Column="1" Text="Quitar" Command="{Binding ClearLogoCommand}"
                                                IsVisible="{Binding HasSelectedLogo}" FontSize="{DynamicResource SmallFontSize}" Padding="10,8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="3. Reporte maestro" FontFamily="Segoe UI Semibold" FontSize="{DynamicResource BodyFontSize}" />
                            <Border x:Name="UploadDropArea" IsVisible="{Binding ShowUploadArea}"
                                    BackgroundColor="{DynamicResource InputBackground}" Padding="14"
                                    Stroke="{DynamicResource AccentColor}" StrokeDashArray="8,6"
                                    StrokeShape="RoundRectangle 8" StrokeThickness="2">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickUploadFileCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Image HeightRequest="24" WidthRequest="24" Source="up_loading.png" />
                                    <Label Text="{Binding UploadAreaTitle}" FontFamily="Segoe UI Semibold" FontSize="{DynamicResource BodyFontSize}" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding UploadAreaSubtitle}" FontSize="{DynamicResource SmallFontSize}" HorizontalTextAlignment="Center" TextColor="{DynamicResource SecondaryText}" />
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding HasSelectedUploadFile}" Spacing="8">
                                <Label Text="{Binding SelectedUploadFileName}" FontSize="{DynamicResource SmallFontSize}" LineBreakMode="TailTruncation" TextColor="{DynamicResource SecondaryText}" />
                                <Button Style="{DynamicResource SecondaryAction}" Text="Cambiar archivo maestro" Command="{Binding ChangeMasterFileCommand}" FontSize="{DynamicResource SmallFontSize}" Padding="10,8" />
                            </VerticalStackLayout>
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource AccentColor}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Border x:Name="ImportStatusPanel" IsVisible="{Binding ShowDocumentControls}"
                            BackgroundColor="{DynamicResource SurfaceBackground}" Padding="12"
                            Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding StatusMessage}" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource SecondaryText}" />
                            <Label Text="{Binding ImportSummaryText}" FontSize="{DynamicResource SmallFontSize}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="PreGenerationSummary" IsVisible="{Binding ShowPreGenerationSummary}"
                            BackgroundColor="{DynamicResource SurfaceBackground}" Padding="12"
                            Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Resumen de generación" FontFamily="Segoe UI Semibold" FontSize="{DynamicResource BodyFontSize}" />
                            <Label Text="{Binding PreGenerationSummaryText}" FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        <Border
            x:Name="PreviewPanel"
            Grid.Column="1"
            BackgroundColor="{DynamicResource SurfaceBackground}"
            Padding="0"
            Stroke="{DynamicResource OutlineColor}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding ShowDocumentControls}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                </DataTrigger>
            </Border.Triggers>
            <Grid RowDefinitions="Auto,*">
                <Grid
                    Padding="12,10,12,8"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto,Auto">
                    <Label Text="4. Revisa y selecciona las personas" FontFamily="Segoe UI Semibold" FontSize="{DynamicResource BodyFontSize}" TextColor="{DynamicResource PrimaryText}" Margin="0,0,0,8" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="0"
                        ClearButtonVisibility="WhileEditing"
                        Placeholder="Buscar por nombre o cedula"
                        Text="{Binding PreviewSearchText}" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        FontFamily="Segoe UI"
                        FontSize="{DynamicResource SmallFontSize}"
                        Text="{Binding PreviewResultsCountText}"
                        TextColor="{DynamicResource SecondaryText}" />
                    <Button Style="{DynamicResource SecondaryAction}"
                        Grid.Row="0"
                        Grid.Column="1"
                        Clicked="OnTogglePreviewExpandedClicked"
                        FontFamily="Segoe UI Semibold"
                        FontSize="16"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        MinimumWidthRequest="36"
                        Padding="8,0"
                        Text="{Binding PreviewExpandButtonText}"
                        VerticalOptions="Fill" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout
                        Padding="12,0,12,12"
                        BindableLayout.ItemsSource="{Binding PreviewRecords}"
                        Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="{DynamicResource SurfaceBackground}"
                                    Padding="10,8"
                                    Stroke="{DynamicResource OutlineColor}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleSelectionCommand}"
                                            NumberOfTapsRequired="2" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8">
                                            <CheckBox
                                                IsChecked="{Binding IsSelected}"
                                                IsEnabled="{Binding CanGenerate}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Segoe UI Semibold"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding FullNameDisplay}"
                                                TextColor="{DynamicResource PrimaryText}"
                                                VerticalOptions="Center" />
                                            <HorizontalStackLayout
                                                Grid.Column="2"
                                                Spacing="4">
                                                <Button
                                                    Style="{DynamicResource GenderChip}"
                                                    BackgroundColor="{Binding MaleButtonBackground}"
                                                    Command="{Binding SelectMaleCommand}"
                                                    Text="H"
                                                    TextColor="{Binding MaleButtonTextColor}" />
                                                <Button
                                                    Style="{DynamicResource GenderChip}"
                                                    BackgroundColor="{Binding FemaleButtonBackground}"
                                                    Command="{Binding SelectFemaleCommand}"
                                                    Text="M"
                                                    TextColor="{Binding FemaleButtonTextColor}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">
                                            <Label
                                                FontFamily="Segoe UI"
                                                FontSize="{DynamicResource SmallFontSize}"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding RowSummary}"
                                                TextColor="{DynamicResource SecondaryText}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="Segoe UI"
                                                FontSize="{DynamicResource SmallFontSize}"
                                                Text="{Binding StatusText}"
                                                TextColor="{DynamicResource SecondaryText}" />
                                        </Grid>

                                        <Label
                                            FontFamily="Segoe UI"
                                            FontSize="{DynamicResource SmallFontSize}"
                                            IsVisible="{Binding HasWarnings}"
                                            Text="{Binding WarningsText}"
                                            TextColor="{DynamicResource DangerText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>


        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Label Text="Selecciona las personas y revisa los datos antes de generar."
                   FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource SecondaryText}" VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasGenerationSummary}" Value="True">
                        <Setter Property="Text" Value="{Binding GenerationSummaryText}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Button Style="{DynamicResource PrimaryAction}" Grid.Column="1" Text="Generar archivos" Command="{Binding GenerateFilesCommand}"
                    IsEnabled="{Binding CanGenerate}" MinimumWidthRequest="180" />
        </Grid>
        <controls:ResultActionsView Grid.Row="3" BindingContext="{Binding Results}" />
    </Grid>
</ContentView>