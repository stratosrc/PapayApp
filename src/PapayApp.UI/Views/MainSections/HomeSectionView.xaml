<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.HomeSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Padding="36"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="24">
        <VerticalStackLayout
            Spacing="8">
            <Label
                FontFamily="Segoe UI Semibold"
                FontSize="56"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="{Binding WelcomeTitle}"
                TextColor="{StaticResource PrimaryText}" />
            <Label
                FontFamily="Segoe UI"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="{Binding WelcomeSubtitle}"
                TextColor="{StaticResource SecondaryText}" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="18"
            VerticalOptions="Center">
            <VerticalStackLayout
                Spacing="6">
                <Label
                    FontFamily="Segoe UI"
                    FontSize="40"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{Binding DateText}"
                    TextColor="{StaticResource PrimaryText}" />
                <Label
                    FontFamily="Segoe UI Semibold"
                    FontSize="30"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{Binding TimeText}"
                    TextColor="{StaticResource PrimaryText}" />
            </VerticalStackLayout>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12"
                HorizontalOptions="Center">
                <Border
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    Padding="16,12"
                    Stroke="{StaticResource OutlineColor}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="{Binding HomePrimaryCounterText}"
                        TextColor="{StaticResource PrimaryText}" />
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    Padding="16,12"
                    Stroke="{StaticResource OutlineColor}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="{Binding HomeSecondaryCounterText}"
                        TextColor="{StaticResource PrimaryText}" />
                </Border>
            </Grid>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="12">
                <Button
                    BackgroundColor="{StaticResource InputBackground}"
                    Command="{Binding ShowDocumentsCommand}"
                    Padding="20,10"
                    Text="Ir a Área Generadora"
                    TextColor="{StaticResource PrimaryText}" />
                <Button
                    BackgroundColor="{StaticResource InputBackground}"
                    Command="{Binding ShowCertificatesCommand}"
                    Padding="20,10"
                    Text="Ir a Certificados"
                    TextColor="{StaticResource PrimaryText}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            FontFamily="Segoe UI"
            FontSize="12"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            LineBreakMode="TailTruncation"
            Text="{Binding HomeBaseDirectoryText}"
            TextColor="{StaticResource SecondaryText}" />
    </Grid>
</ContentView>
