<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.SettingsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout
        Padding="36"
        Spacing="18">
        <Label
            FontFamily="Segoe UI Semibold"
            FontSize="28"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Text="{Binding SettingsTitle}"
            TextColor="#000000" />

        <Border
            BackgroundColor="#FFFFFF"
            Padding="18"
            Stroke="#DCECF4"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <VerticalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="12">
                    <Entry
                        HorizontalOptions="FillAndExpand"
                        IsReadOnly="True"
                        Placeholder="Ruta base"
                        Text="{Binding SettingsBaseDirectoryPathText}"
                        TextColor="#173753" />
                    <Button
                        BackgroundColor="#173753"
                        Command="{Binding ChangeBaseDirectoryCommand}"
                        Text="Cambiar"
                        TextColor="White" />
                </HorizontalStackLayout>

                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Text="{Binding SettingsStatusMessage}"
                    TextColor="#36586B" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
