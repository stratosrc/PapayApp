<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.SettingsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PapayApp.UI.Controls">
    <Grid Padding="{DynamicResource PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource SectionGap}">
        <controls:PageHeaderView Title="{Binding SettingsTitle}" Subtitle="Configura la app o consulta las guías y soluciones de Ayuda." />
        <HorizontalStackLayout Grid.Row="1" Spacing="{DynamicResource FieldGap}">
            <Button x:Name="ConfigurationTab" Text="Configuración" Clicked="OnConfigurationClicked" Style="{DynamicResource PrimaryAction}" SemanticProperties.Description="Configuración, pestaña seleccionada" />
            <Button x:Name="HelpTab" Text="Ayuda" Clicked="OnHelpClicked" Style="{DynamicResource SecondaryAction}" SemanticProperties.Description="Abrir la pestaña Ayuda" />
        </HorizontalStackLayout>
        <ScrollView x:Name="ConfigurationPanel" Grid.Row="2"><VerticalStackLayout Spacing="{DynamicResource SectionGap}">

        <Border
            BackgroundColor="{DynamicResource SurfaceBackground}"
            Padding="0"
            Stroke="{DynamicResource OutlineColor}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="{DynamicResource SectionHeaderPadding}" BackgroundColor="{DynamicResource InputBackground}">
                    <Label Style="{DynamicResource SectionTitle}" Text="Directorio de resultados" SemanticProperties.HeadingLevel="Level2" />
                </Grid>
                <VerticalStackLayout Padding="{DynamicResource CardPadding}" Spacing="{DynamicResource ControlGap}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ControlGap}">
                    <Entry
                        HorizontalOptions="Fill"
                        IsReadOnly="True"
                        Placeholder="Ruta base"
                        Text="{Binding SettingsBaseDirectoryPathText}"
                        TextColor="{DynamicResource PrimaryText}" />
                    <Button Grid.Column="1" Style="{DynamicResource SecondaryAction}"
                        Command="{Binding ChangeBaseDirectoryCommand}"
                        Text="Cambiar" />
                </Grid>

                <Label Style="{DynamicResource HelpText}"
                    Text="{Binding SettingsStatusMessage}"
                    TextColor="{DynamicResource SecondaryText}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
        <Border BackgroundColor="{DynamicResource SurfaceBackground}" Padding="0"
                Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="{DynamicResource SectionHeaderPadding}" BackgroundColor="{DynamicResource InputBackground}">
                    <Label Style="{DynamicResource SectionTitle}" Text="Apariencia" SemanticProperties.HeadingLevel="Level2" />
                </Grid>
                <VerticalStackLayout Padding="{DynamicResource CardPadding}" Spacing="{DynamicResource ControlGap}">
                    <Label Style="{DynamicResource FieldLabel}" Text="Tema" />
                    <Picker x:Name="ThemePicker" SelectedIndexChanged="OnAppearanceChanged" />
                    <Label Style="{DynamicResource FieldLabel}" Text="Tamaño de texto" />
                    <Picker x:Name="SizePicker" SelectedIndexChanged="OnAppearanceChanged" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
        <Border BackgroundColor="{DynamicResource SurfaceBackground}" Padding="0"
                Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="{DynamicResource SectionHeaderPadding}" BackgroundColor="{DynamicResource InputBackground}">
                    <Label Style="{DynamicResource SectionTitle}" Text="Plantillas de certificados" SemanticProperties.HeadingLevel="Level2" />
                </Grid>
                <VerticalStackLayout Padding="{DynamicResource CardPadding}" Spacing="{DynamicResource ControlGap}">
                    <Label Text="Administra los PDF y sus diseños en un espacio dedicado. Los cambios de plantilla requieren Guardar." />
                    <Button Text="Administrar plantillas" Command="{Binding ShowTemplatesCommand}" Style="{DynamicResource PrimaryAction}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
        <controls:LaboratoryTemplatesEditor x:Name="LaboratoryTemplates" />
    </VerticalStackLayout>
    </ScrollView>
        <controls:HelpCenterView x:Name="HelpPanel" Grid.Row="2" IsVisible="False" />
    </Grid>
</ContentView>
