<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.SettingsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout
        Padding="36"
        Spacing="18">
        <Label
            FontFamily="Segoe UI Semibold"
            FontSize="28"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Text="{Binding SettingsTitle}"
            TextColor="{StaticResource PrimaryText}" />

        <Border
            BackgroundColor="{StaticResource SurfaceBackground}"
            Padding="18"
            Stroke="{StaticResource OutlineColor}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <VerticalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="12">
                    <Entry
                        HorizontalOptions="FillAndExpand"
                        IsReadOnly="True"
                        Placeholder="Ruta base"
                        Text="{Binding SettingsBaseDirectoryPathText}"
                        TextColor="{StaticResource PrimaryText}" />
                    <Button
                        BackgroundColor="{StaticResource PrimaryButtonBackground}"
                        Command="{Binding ChangeBaseDirectoryCommand}"
                        Text="Cambiar"
                        TextColor="White" />
                </HorizontalStackLayout>

                <Label
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Text="{Binding SettingsStatusMessage}"
                    TextColor="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
