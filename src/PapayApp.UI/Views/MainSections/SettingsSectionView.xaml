<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Views.MainSections.SettingsSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Padding="36"
        RowDefinitions="Auto,*"
        RowSpacing="24">
        <Label
            FontFamily="Segoe UI Semibold"
            FontSize="28"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Text="Ajustes"
            TextColor="#000000" />

        <Label
            Grid.Row="1"
            FontFamily="Segoe UI Semibold"
            FontSize="24"
            HorizontalTextAlignment="Center"
            Text="{Binding SettingsPlaceholder}"
            TextColor="#000000"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
