<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PapayApp.UI.Controls.AnimatedStackView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="360"
    WidthRequest="180">
    <Grid
        x:Name="StackRoot"
        IsClippedToBounds="True">
        <Border
            x:Name="BackCard"
            BackgroundColor="#2892D7"
            HeightRequest="126"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0"
            WidthRequest="126">
            <Border.Shadow>
                <Shadow Brush="#0E2638" Opacity="0.18" Radius="24" Offset="-8,8" />
            </Border.Shadow>
        </Border>

        <Border
            x:Name="MiddleCard"
            BackgroundColor="#6DAEDB"
            HeightRequest="126"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0"
            WidthRequest="126">
            <Border.Shadow>
                <Shadow Brush="#0E2638" Opacity="0.16" Radius="22" Offset="-7,7" />
            </Border.Shadow>
        </Border>

        <Border
            x:Name="FrontCard"
            BackgroundColor="#F4FAFD"
            HeightRequest="126"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0"
            WidthRequest="126">
            <Grid>
