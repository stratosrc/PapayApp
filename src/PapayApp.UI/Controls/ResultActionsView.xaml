<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="PapayApp.UI.Controls.ResultActionsView" IsVisible="{Binding HasResult}">
<VerticalStackLayout Spacing="8">
<FlexLayout Wrap="Wrap">
<Button Text="{Binding FileActionText}" Command="{Binding OpenFileCommand}" IsVisible="{Binding HasFile}" Style="{DynamicResource SecondaryAction}" Margin="0,0,8,8" />
<Button Text="Abrir carpeta" Command="{Binding OpenFolderCommand}" Style="{DynamicResource SecondaryAction}" Margin="0,0,8,8" />
<Button Text="Ver errores" Command="{Binding OpenErrorsCommand}" IsVisible="{Binding HasErrors}" Style="{DynamicResource SecondaryAction}" Margin="0,0,8,8" />
<Button Text="Generar otro lote" Command="{Binding NewBatchCommand}" Style="{DynamicResource SecondaryAction}" Margin="0,0,8,8" />
</FlexLayout><Label Text="{Binding Message}" /></VerticalStackLayout></ContentView>
