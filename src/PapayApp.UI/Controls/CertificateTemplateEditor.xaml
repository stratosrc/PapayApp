<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PapayApp.UI.Controls.CertificateTemplateEditor">
    <Border Padding="18" BackgroundColor="{DynamicResource SurfaceBackground}"
            Stroke="{DynamicResource OutlineColor}" StrokeShape="RoundRectangle 10">
        <VerticalStackLayout Spacing="12">
            <Label Text="Plantilla de certificado" FontSize="22" TextColor="{DynamicResource PrimaryText}" />
            <Label x:Name="ActiveTemplateLabel" TextColor="{DynamicResource PrimaryText}" />
            <Label Text="Plantillas guardadas" TextColor="{DynamicResource SecondaryText}" />
            <Picker x:Name="TemplatePicker" Title="Selecciona una plantilla" ItemDisplayBinding="{Binding Name}"
                    SelectedIndexChanged="OnTemplateSelected" />
            <Label Text="Seleccionar solo abre el diseño para editarlo. Pulsa Guardar para conservar los cambios y usar esta plantilla en los próximos certificados."
                   TextColor="{DynamicResource SecondaryText}" FontSize="{DynamicResource SmallFontSize}" />
            <Label Text="Nombre de la plantilla" TextColor="{DynamicResource SecondaryText}" />
            <Entry x:Name="TemplateNameEntry" Placeholder="Ej.: Participación — Institución" TextChanged="OnTemplateNameEdited" />
            <Label Text="Carga un PDF y configura sus componentes. Arrastra los rectángulos para moverlos y sus esquinas para cambiar el tamaño. Los cambios se aplican al guardar."
                   TextColor="{DynamicResource SecondaryText}" />
            <FlexLayout Wrap="Wrap">
                <Button Style="{DynamicResource SecondaryAction}" x:Name="LoadButton" Text="Nueva plantilla desde PDF" Clicked="OnLoadPdf" Margin="0,0,8,8" />
                <Button Style="{DynamicResource PrimaryAction}" x:Name="SaveButton" Text="Guardar plantilla" Clicked="OnSave" Margin="0,0,8,8" />
                <Button Style="{DynamicResource SecondaryAction}" Text="Descartar cambios" Clicked="OnDiscard" Margin="0,0,8,8" />
                <Button Style="{DynamicResource SecondaryAction}" Text="Restaurar diseño original" Clicked="OnRestore" Margin="0,0,8,8" />
            </FlexLayout>
            <Label x:Name="StatusLabel" TextColor="{DynamicResource SecondaryText}" />
            <VerticalStackLayout x:Name="Workspace" Spacing="10" IsVisible="False">
                <Label x:Name="FileLabel" TextColor="{DynamicResource PrimaryText}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button Style="{DynamicResource SecondaryAction}" Text="Anterior" Clicked="OnPreviousPage" />
                    <Label x:Name="PageLabel" Grid.Column="1" VerticalOptions="Center" HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource PrimaryText}" />
                    <Button Style="{DynamicResource SecondaryAction}" Grid.Column="2" Text="Siguiente" Clicked="OnNextPage" />
                </Grid>
                <Grid x:Name="PreviewHost" SizeChanged="OnPreviewSizeChanged">
                    <Grid x:Name="PageCanvas" HorizontalOptions="Center" BackgroundColor="White">
                        <Image x:Name="PdfImage" Aspect="Fill" InputTransparent="True" />
                        <GraphicsView x:Name="Overlay" BackgroundColor="Transparent"
                                      StartInteraction="OnStartInteraction" DragInteraction="OnDragInteraction"
                                      EndInteraction="OnEndInteraction" CancelInteraction="OnCancelInteraction" />
                    </Grid>
                </Grid>
                <FlexLayout Wrap="Wrap">
                    <Button Style="{DynamicResource SecondaryAction}" Text="Agregar texto" Clicked="OnAddText" Margin="0,0,8,8" />
                    <Button Style="{DynamicResource SecondaryAction}" Text="Agregar texto fijo" Clicked="OnAddFixedText" Margin="0,0,8,8" />
                    <Button Style="{DynamicResource SecondaryAction}" Text="Agregar firma" Clicked="OnAddSignature" Margin="0,0,8,8" />
                    <Button Style="{DynamicResource SecondaryAction}" Text="Agregar firmante (firma, nombre y cargo)" Clicked="OnAddSigner" Margin="0,0,8,8" />
                    <Button Style="{DynamicResource DestructiveAction}" Text="Eliminar componente" Clicked="OnDelete" Margin="0,0,8,8" />
                </FlexLayout>
                <Label Text="Componentes de esta página (el último se dibuja encima):" TextColor="{DynamicResource SecondaryText}" />
                <Picker x:Name="ElementPicker" ItemDisplayBinding="{Binding Name}" SelectedIndexChanged="OnElementSelected" />
                <VerticalStackLayout x:Name="Inspector" Spacing="8" IsVisible="False">
                    <Label Text="Nombre del componente" TextColor="{DynamicResource SecondaryText}" />
                    <Entry x:Name="NameEntry" TextChanged="OnTextEdited" Unfocused="OnNameUnfocused" />
                    <HorizontalStackLayout Spacing="12">
                        <Switch x:Name="InputSwitch" Toggled="OnInputToggled" />
                        <Label Text="Solicitar este dato de forma independiente al generar" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="El nombre del componente será la etiqueta del campo en Certificados. Cada dato se completa una vez por lote; cada firma independiente permite elegir su propio PNG. Guarda la plantilla para aplicar los cambios." FontSize="{DynamicResource SmallFontSize}" />
                    <VerticalStackLayout x:Name="TextInspector" Spacing="8">
                        <Label Text="Contenido (texto fijo y/o variables)" TextColor="{DynamicResource SecondaryText}" />
                        <Editor x:Name="ContentEditor" AutoSize="TextChanges" MinimumHeightRequest="80" TextChanged="OnTextEdited" />
                        <Label Text="Variables: {nombre}, {cedula}, {folio}, {fecha}, {tipo}, {texto}, {firmante}, {cargo}. Fecha: ddMMyyyy. El bloque se ajusta al área reduciendo la fuente si hace falta."
                               FontSize="{DynamicResource SmallFontSize}" TextColor="{DynamicResource SecondaryText}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Fuente" TextColor="{DynamicResource SecondaryText}" />
                                <Picker x:Name="FontPicker" SelectedIndexChanged="OnFormatEdited" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Tamaño máximo (6–144 pt)" TextColor="{DynamicResource SecondaryText}" />
                                <Entry x:Name="FontSizeEntry" Keyboard="Numeric" TextChanged="OnTextEdited" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="Color (#RRGGBB)" TextColor="{DynamicResource SecondaryText}" />
                                <Entry x:Name="ColorEntry" TextChanged="OnTextEdited" />
                            </VerticalStackLayout>
                        </Grid>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="Negrita (Cinzel)" VerticalOptions="Center" TextColor="{DynamicResource SecondaryText}" />
                            <Switch x:Name="BoldSwitch" Toggled="OnBoldEdited" />
                            <Picker x:Name="AlignmentPicker" WidthRequest="180" SelectedIndexChanged="OnFormatEdited" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
