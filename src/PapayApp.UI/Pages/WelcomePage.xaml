<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PapayApp.UI.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PapayApp.UI.Controls"
    NavigationPage.HasNavigationBar="False">
    <Grid
        Padding="32"
        BackgroundColor="#E6173753"
        RowDefinitions="*,Auto">
        <Grid
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <controls:AnimatedStackView />
        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            Padding="0,0,0,36"
            Spacing="6">
            <Label
                Style="{StaticResource WelcomeTitle}"
                Text="{Binding Greeting}" />
            <Label
                Style="{StaticResource WelcomeDate}"
                Text="{Binding DateText}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
