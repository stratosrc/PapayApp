<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PapayApp.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sections="clr-namespace:PapayApp.UI.Views.MainSections"
    xmlns:shell="clr-namespace:PapayApp.UI.Views.Shell"
    NavigationPage.HasNavigationBar="False">
    <Grid
        BackgroundColor="#FFFFFF"
        ColumnDefinitions="Auto,*">
        <shell:SideNavigationView />

        <Grid Grid.Column="1">
            <sections:HomeSectionView IsVisible="{Binding IsHomeVisible}" />
            <sections:DocumentsSectionView IsVisible="{Binding IsDocumentsVisible}" />
            <sections:FoldersSectionView IsVisible="{Binding IsFoldersVisible}" />
            <sections:SettingsSectionView IsVisible="{Binding IsSettingsVisible}" />
        </Grid>
    </Grid>
</ContentPage>
